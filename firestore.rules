rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: leads
    // Document ID: auto-generated
    // Fields:
    //   - userId: string (required) - The ID of the user who submitted the lead.
    //   - fileUrl: string (required) - The URL of the uploaded file in Firebase Storage.
    //   - fileLengthWords: number (optional) - The estimated number of words in the file.
    //   - calculatedPrice: number (required) - The total calculated price for the selected services.
    //   - options: map (optional) - Selected services.
    //   - languages: map (optional) - Source and target languages.
    //   - createdAt: timestamp (required) - When the lead was created.
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      // Allow the authenticated anonymous user to match their userId
      return (isAuthenticated() && request.auth.uid == userId) || (!isAuthenticated() && userId != null);
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "codykayak@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidLead(data) {
      // The frontend creates a lot of custom fields now, so let's relax this validation
      // to the essential required fields to prevent breaking the flow.
      return data.userId is string &&
             data.fileUrl is string &&
             data.calculatedPrice is number &&
             data.createdAt != null;
    }

    match /leads/{leadId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      // Allow unauthenticated creation as long as it's a valid lead
      allow create: if isValidLead(request.resource.data);
      allow update: if false; // Leads are immutable for now
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId) && !('role' in request.resource.data);
      allow delete: if false;
    }

    // Old Tartar Research — per-user research data (users/{uid}/tartarResearch/…)
    match /users/{userId}/tartarResearch/{docId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
    }
    match /users/{userId}/tartarResearch/data/{subcollection}/{itemId} {
      allow read, write: if isAuthenticated() && isOwner(userId)
        && subcollection in ['mentions', 'entities', 'sources', 'searchTerms', 'anomalies'];
      allow read: if isAuthenticated() && isOwner(userId)
        && subcollection in ['ingestionJobs', 'usageLog'];
      allow create: if isAuthenticated() && isOwner(userId)
        && subcollection == 'ingestionJobs';
    }
    match /tartarPlatform/{collection}/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    match /tartarPlatform/catalog/promoCodes/{codeId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    match /tartarPlatform/pool/{subcollection}/{itemId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ===============================================================
    // AiBhive Pros — company field ops (Diagnose)
    // Most reads/writes go through Admin SDK (/api/pros/*).
    // Client rules below are a safety net for direct SDK access.
    // ===============================================================
    function prosMemberOf(companyId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/pros_memberships/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/pros_memberships/$(request.auth.uid)).data.companyId == companyId;
    }

    match /pros_memberships/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow write: if false;
    }

    match /pros_companies/{companyId} {
      allow read: if prosMemberOf(companyId) || isAdmin();
      allow write: if false;

      match /members/{memberId} {
        allow read: if prosMemberOf(companyId) || isAdmin();
        allow write: if false;
      }
      match /jobs/{jobId} {
        allow read: if prosMemberOf(companyId) || isAdmin();
        allow write: if false;
      }
      match /activity/{eventId} {
        allow read: if prosMemberOf(companyId) || isAdmin();
        allow write: if false;
      }
      match /secrets/{docId} {
        allow read, write: if false;
      }
    }
  }
}
