rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow uploads to the leads directory for the current anonymous session
    match /leads/{sessionId}/{allPaths=**} {
      // Lead Agent APK (~120MB debug) + compressed mirrors
      allow create: if request.resource.size < 160 * 1024 * 1024;
      allow read: if true;
      allow update, delete: if false;
    }

    // Published mobile manifests + APK mirrors (anonymous auth from publish scripts)
    match /mobile/{allPaths=**} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.size < 160 * 1024 * 1024;
      allow update: if request.auth != null && request.resource.size < 160 * 1024 * 1024;
      allow delete: if false;
    }
  }
}
