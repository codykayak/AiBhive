rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow unauthenticated uploads to the leads directory to match the frontend form submission flow
    match /leads/{sessionId}/{allPaths=**} {
      allow create: if request.resource.size < 50 * 1024 * 1024; // Limit to 50MB
      // Reading/updating/deleting requires admin
      allow read, update, delete: if false;
    }
  }
}
