{
  "expo": {
    "name": "AiBhivePlants",
    "slug": "aibhive-plants",
    "version": "1.0.4",
    "orientation": "default",
    "icon": "./icon.png",
    "scheme": "aibhiveplants",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.aibhive.plants",
      "versionCode": 5,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-splash-screen"
    ]
  }
}
