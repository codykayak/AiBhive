# Dependencies & build output
node_modules/
**/node_modules/
build/
dist/
coverage/
.tmp/
*.log

# Secrets
.env*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
*.lnk

# Git worktrees & duplicate nested checkout (use repo root src/, not aibhive-main-fixed/)
.worktrees/
aibhive-main-fixed/

# Green Team / pentest lab — local study only, never ship via git or Cloud Build
greenteam/

# Large binaries — store in GCS; link from public/ at deploy time if needed
**/*.epub
**/*.zip
**/*.7z
**/*.dmg
**/*.exe
**/*.msi
steward/desktop/release*/
**/*.source.mp4

# Duplicate hero videos (site serves copies from public/)
src/**/*.mp4
src/**/*.webm

# Mobile APKs — Firebase Storage only (not git / not Cloud Build)
public/*.apk

# Mobile / sub-app source trees
taylored-mobile/
aibhive-diagnose/
aibhive-plants/

# Optional local-only trees
manydoorsai-main/
anticheat-lab/fixtures/*.mp4
services/dmt-matrix-decoder/catalog/
