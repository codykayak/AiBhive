{
  "expo": {
    "name": "taylored-mobile",
    "slug": "taylored-mobile",
    "version": "1.0.5",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#020617"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tayloredmobile.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#020617"
      },
      "package": "com.tayloredmobile.app",
      "resizeableActivity": true
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow photo access to attach job listing screenshots.",
          "cameraPermission": "Allow camera access to capture job listing screenshots."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
