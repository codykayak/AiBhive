+    { "position": "3 o'clock liver / gallbladder (right eye)", "jensenNotes": "Right iris — hepatic/biliary sector in Jensen tradition" },
+    { "position": "5-6 o'clock digestive / colon", "jensenNotes": "Lower digestive tract, colon reflex zones" },
+    { "position": "7-8 o'clock lung / breast", "jensenNotes": "Respiratory and chest sectors — use cautious language only" },
+    { "position": "9 o'clock kidney / adrenal", "jensenNotes": "Filtration, adrenal stress themes in iridology texts" },
+    { "position": "6 o'clock legs / pelvis", "jensenNotes": "Lower extremity and pelvic reflex areas" }
+  ],
+  "signs": [
+    { "sign": "lacuna", "physicalMeaning": "Pit or cavity in iris stroma — often linked to inherited weakness or chronic irritation in iridology texts" },
+    { "sign": "crypt", "physicalMeaning": "Deep closed pit — stronger emphasis on inherited tendency in European iridology" },
+    { "sign": "nerve ring", "physicalMeaning": "Concentric white ring — nervous system stress or sensitivity in traditional readings" },
+    { "sign": "pigment spot", "physicalMeaning": "Brown/rust deposit — localized sign; map to nearest zone cautiously" },
+    { "sign": "open fibers", "physicalMeaning": "Loose iris texture — lymphatic or reactive constitution in Jensen typing" },
+    { "sign": "dense fibers", "physicalMeaning": "Tight iris texture — hematogenic or biliary tendencies in classic typing" },
+    { "sign": "arcus senilis", "physicalMeaning": "White/grey ring at limbus — age-related; iridologists note cardiovascular themes (not diagnostic)" }
+  ],
+  "constitutionalTypes": [
+    { "type": "lymphatic", "patterns": "Blue-grey iris, open fibers, mucus congestion themes in iridology literature" },
+    { "type": "biliary", "patterns": "Mixed brown-yellow, dense fibers, digestive and inflammatory themes" },
+    { "type": "hematogenic", "patterns": "Brown iris, dense structure, blood/iron and metabolic themes" },
+    { "type": "neurogenic", "patterns": "Nerve rings, fine radial lines, nervous system sensitivity themes" }
+  ],
+  "photoQualityTips": [
+    "Use natural daylight; avoid direct flash.",
