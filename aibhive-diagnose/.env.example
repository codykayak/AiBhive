# Pros API (required for company Grok + job sync)
EXPO_PUBLIC_API_URL=https://aibhive.com

EXPO_PUBLIC_GROK_API_KEY=
EXPO_PUBLIC_GROK_MODEL=grok-2-vision-1212

# Pros / Firebase (optional — defaults to AiBhive project)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=

# Native Google sign-in (Expo Go / EAS) — Web OAuth client from Firebase
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
