{
  "expo": {
    "name": "AiBhive Diagnose",
    "slug": "aibhive-diagnose",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aibhivediagnose",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aibhive.diagnose",
      "infoPlist": {
        "NSCameraUsageDescription": "AiBhive Diagnose needs the camera to photograph equipment for AI diagnosis.",
        "NSMicrophoneUsageDescription": "AiBhive Diagnose needs the microphone for voice commands in the field.",
        "NSPhotoLibraryUsageDescription": "AiBhive Diagnose needs photo access to diagnose equipment from your gallery."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0F14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.aibhive.diagnose",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B0F14"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AiBhive Diagnose to access photos for equipment diagnosis.",
          "cameraPermission": "Allow AiBhive Diagnose to photograph equipment for AI diagnosis."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "aibhive-diagnose"
      }
    }
  }
}
