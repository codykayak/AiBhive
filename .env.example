# Copy to .env.local and fill in values (gitignored).
# Backend loads .env.local first, then .env.

# --- Required for most AI features ---
GEMINI_API_KEY=

# --- Required for backend APIs (Firestore, GCS, admin) ---
# Absolute path to a GCP service-account JSON key.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Grok (homework, intel chat) ---
# XAI_API_KEY=
# GROK_API_KEY=

# --- Cartesia TTS (Pros Diagnose narration when Grok AI is active) ---
# CARTESIA_API_KEY=          # https://cartesia.ai — server-side only, never in the app
# CARTESIA_VOICE_ID=db6b0ed5-d5d3-463d-ae85-518a07d3c2b4
# CARTESIA_MODEL_ID=sonic-3.5
# CARTESIA_SPEED=1.2

# --- Diagnose operation cost estimates (raw platform USD, before Hive markup) ---
# DIAGNOSE_WEB_CHAT_RAW_COST=0.01
# DIAGNOSE_WEB_VISION_RAW_COST=0.022
# DIAGNOSE_TRANSCRIBE_RAW_COST=0.004
# CARTESIA_USD_PER_CHAR=0.00005
# DIAGNOSE_TTS_TYPICAL_CHARS=300

# --- Admin / homework login allowlist (comma-separated Google emails) ---
# ADMIN_EMAILS=you@gmail.com

# --- Optional cloud search (Research / Discovery — required on Cloud Run for company lists) ---
# FIRECRAWL_API_KEY=   # https://firecrawl.dev — Deep web search
# SERPAPI_KEY=         # https://serpapi.com — Quick factual search

# --- Fable Scrape residential proxy pool (protects the AiBhive host IP) ---
# Any HTTP(S) proxy endpoint works. Most providers give a rotating gateway URL:
#   DataImpulse: http://USER:PASS@gw.dataimpulse.com:823
#   IPRoyal:     http://USER:PASS@geo.iproyal.com:12321
#   Webshare:    http://USER:PASS@p.webshare.io:80
# Single rotating gateway:
# FABLE_SCRAPE_RESIDENTIAL_PROXY=http://USER:PASS@gw.dataimpulse.com:823
# Or a comma/newline-separated pool (one picked at random per request):
# FABLE_SCRAPE_PROXIES=http://USER:PASS@host1:port,http://USER:PASS@host2:port

# --- Fable Scrape AI roster (director / OCR-vision / translator) ---
# Any subset works; users can also paste their own keys per-session (BYOK).
#   Grok:     XAI_API_KEY (or GROK_API_KEY)          — default Director
#   Gemini:   GEMINI_API_KEY (or GOOGLE_API_KEY)     — default Vision/OCR + Translator
#   Claude:   ANTHROPIC_API_KEY
#   Kimi:     KIMI_API_KEY (or MOONSHOT_API_KEY)
#   DeepSeek: DEEPSEEK_API_KEY
# Optional model overrides: FABLE_GROK_MODEL, FABLE_GROK_VISION_MODEL, FABLE_GEMINI_MODEL,
#   FABLE_CLAUDE_MODEL, FABLE_KIMI_MODEL, FABLE_DEEPSEEK_MODEL

# --- Old Tartar Research (optional async ingestion worker) ---
# TARTAR_WORKER_SECRET=
# TARTAR_PROMO_CODES=PARTNER2025:0.05,EARLYBIRD:0.05
# KIMI_API_KEY=
# TARTAR_API_URL=https://aibhive.com
# APP_URL=http://127.0.0.1:3000
# STRIPE_SECRET_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# SOCIAL_NOTIFY_PHONE=+1xxxxxxxxxx
# AUTOPOSTER_CRON_SECRET=
# DISABLE_AUTOPOSTER_SCHEDULER=true

# --- Platform cost protection (Research Lab / OCR / Fable) ---
# Public unmetered OCR/Fable/Firecrawl are OFF in production unless:
# ALLOW_PUBLIC_PLATFORM_AI=true
# ALLOW_TEST_CHECKOUT=true
# PLATFORM_DAILY_USD_CAP=200
# PLATFORM_MAX_USD_PER_USER_DAY=25
# PLATFORM_MAX_CONCURRENT_JOBS=2
# OCR_MAX_IMAGES=50
# FABLE_MAX_CRAWL_PAGES=20
# FABLE_MAX_HARVEST_FINDINGS=8
# FABLE_MAX_TRANSLATE_CHARS=8000

# --- DMT Matrix Decoder (Research Lab — Python Cloud Run worker) ---
# DMT_DECODER_URL=https://dmt-matrix-decoder-xxxxx-uc.a.run.app
# DMT_DECODER_WORKER_SECRET=
# RESEARCH_LAB_DMT_DECODE_RAW=0.018
# RESEARCH_LAB_DMT_RESEARCH_BUDGET_USD=1
# RESEARCH_LAB_DMT_RESEARCH_RAW_PER_GLYPH=0.085
# Local worker: cd services/dmt-matrix-decoder && pip install -r requirements.txt && gunicorn ...
# Sync catalogue: npm run sync:dmt-catalog  (fetches dmtcode.com registry_glyphs PNGs)
