# Copy to .env.local and fill in values (gitignored).
# Backend loads .env.local first, then .env.

# --- Required for most AI features ---
GEMINI_API_KEY=

# --- Required for backend APIs (Firestore, GCS, admin) ---
# Absolute path to a GCP service-account JSON key.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Grok (homework, intel chat) ---
# XAI_API_KEY=
# GROK_API_KEY=

# --- Admin / homework login allowlist (comma-separated Google emails) ---
# ADMIN_EMAILS=you@gmail.com

# --- Optional cloud search (Research / Discovery — required on Cloud Run for company lists) ---
# FIRECRAWL_API_KEY=   # https://firecrawl.dev — Deep web search
# SERPAPI_KEY=         # https://serpapi.com — Quick factual search

# --- Old Tartar Research (optional async ingestion worker) ---
# TARTAR_WORKER_SECRET=
# TARTAR_PROMO_CODES=PARTNER2025:0.05,EARLYBIRD:0.05
# KIMI_API_KEY=
# TARTAR_API_URL=https://aibhive.com
# APP_URL=http://127.0.0.1:3000
# STRIPE_SECRET_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# SOCIAL_NOTIFY_PHONE=+1xxxxxxxxxx
# AUTOPOSTER_CRON_SECRET=
# DISABLE_AUTOPOSTER_SCHEDULER=true
